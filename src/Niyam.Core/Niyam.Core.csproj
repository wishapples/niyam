<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <!-- PDF text extraction: PdfPig (Apache-2.0) from NuGet. Set PdfPigSource to a local PdfPig .csproj to build without NuGet. -->
  <ItemGroup Condition="'$(PdfPigSource)' == ''">
    <PackageReference Include="PdfPig" Version="0.1.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(PdfPigSource)' != ''">
    <ProjectReference Include="$(PdfPigSource)" />
  </ItemGroup>
</Project>
